    {
      "id": "telegram-alerts",
      "manifest": {
        "id": "telegram-alerts",
        "name": "Telegram Alerts",
        "version": "1.0.0",
        "description": "Send trading alerts and notifications to Telegram channels or private chats.",
        "author": "Gordon Team",
        "category": "utility",
        "tools": [
          {
            "name": "send_alert",
            "description": "Send an alert message to Telegram",
            "inputSchema": {
              "type": "object",
              "properties": {
                "message": { "type": "string", "description": "Alert message" },
                "chatId": { "type": "string", "description": "Telegram chat ID" }
              },
              "required": ["message"]
            }
          },
          {
            "name": "send_trade_notification",
            "description": "Send a formatted trade notification",
            "inputSchema": {
              "type": "object",
              "properties": {
                "symbol": { "type": "string" },
                "side": { "type": "string", "enum": ["buy", "sell"] },
                "price": { "type": "number" },
                "quantity": { "type": "number" }
              },
              "required": ["symbol", "side", "price", "quantity"]
            }
          }
        ],
        "authentication": {
          "type": "api_key",
          "envVar": "TELEGRAM_BOT_TOKEN",
          "fields": [
            {
              "name": "botToken",
              "label": "Bot Token",
              "sensitive": true
            },
            {
              "name": "defaultChatId",
              "label": "Default Chat ID",
              "sensitive": false
            }
          ]
        }
      },
      "repository": "https://github.com/gordon-marketplace/telegram-alerts",
