    {
      "id": "coingecko",
      "manifest": {
        "id": "coingecko",
        "name": "CoinGecko Data",
        "version": "1.0.0",
        "description": "Historical price data from CoinGecko API. Get OHLC data, market caps, volumes, and more for thousands of cryptocurrencies.",
        "author": "Gordon Team",
        "category": "data-provider",
        "tools": [
          {
            "name": "get_historical_prices",
            "description": "Get historical OHLC data for a cryptocurrency",
            "inputSchema": {
              "type": "object",
              "properties": {
                "coinId": { "type": "string", "description": "CoinGecko coin ID" },
                "days": { "type": "number", "description": "Number of days of history" },
                "interval": { "type": "string", "enum": ["daily", "hourly"] }
              },
              "required": ["coinId"]
            }
          },
          {
            "name": "get_market_data",
            "description": "Get current market data including price, market cap, and volume",
            "inputSchema": {
              "type": "object",
              "properties": {
                "coinId": { "type": "string", "description": "CoinGecko coin ID" }
              },
              "required": ["coinId"]
            }
          }
        ],
        "authentication": {
          "type": "api_key",
          "envVar": "COINGECKO_API_KEY"
        }
      },
      "repository": "https://github.com/gordon-marketplace/coingecko",
      "stars": 245,
      "downloads": 12500,
      "verified": true,
      "officialProvider": false,
      "lastUpdated": "2025-01-01",
      "pricing": {
        "type": "freemium",
        "freeUsage": "50 calls/min",
        "pricingUrl": "https://www.coingecko.com/en/api/pricing"
      }
    },
