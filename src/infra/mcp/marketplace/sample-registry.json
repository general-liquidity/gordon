    {
      "id": "glassnode",
      "manifest": {
        "id": "glassnode",
        "name": "Glassnode On-Chain Analytics",
        "version": "1.0.0",
        "description": "On-chain metrics and analytics from Glassnode. Access NUPL, SOPR, exchange flows, and more.",
        "author": "Gordon Team",
        "category": "research",
        "tools": [
          {
            "name": "get_onchain_metric",
            "description": "Get on-chain metric data for a cryptocurrency",
            "inputSchema": {
              "type": "object",
              "properties": {
                "asset": { "type": "string", "description": "Asset symbol (e.g., BTC)" },
                "metric": { "type": "string", "description": "Metric name (e.g., nupl, sopr)" },
                "resolution": { "type": "string", "enum": ["1h", "24h", "10m"] }
              },
              "required": ["asset", "metric"]
            }
          },
          {
            "name": "get_exchange_flows",
            "description": "Get exchange inflow/outflow data",
            "inputSchema": {
              "type": "object",
              "properties": {
                "asset": { "type": "string", "description": "Asset symbol" },
                "exchange": { "type": "string", "description": "Exchange name (optional)" }
              },
              "required": ["asset"]
            }
          }
