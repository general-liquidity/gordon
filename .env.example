# Gordon CLI - Environment Configuration
# Copy this file to ~/.gordon/.env and fill in your API keys

# ============================================================================
# LLM Provider (at least one required)
# ============================================================================

# OpenAI - Recommended, widely available
# OPENAI_API_KEY=sk-...

# Dedalus Labs - Multi-model gateway (access 20+ models with one key)
# DEDALUS_API_KEY=dsk_...

# Inception Labs - Mercury 2 (OpenAI-compatible, 128K context)
# INCEPTION_API_KEY=...

# Anthropic Claude (optional)
# ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini (optional)
# GOOGLE_GENERATIVE_AI_API_KEY=...
# GOOGLE_API_KEY=...              # Alternative (fallback if above not set)

# Groq - Fast inference (optional)
# GROQ_API_KEY=gsk_...

# ============================================================================
# Exchange: Binance
# Create keys at: Binance > Account > API Management
# ============================================================================

# BINANCE_API_KEY=
# BINANCE_API_SECRET=

# ============================================================================
# Exchange: Binance US (alternative for US users)
# Create keys at: Binance.US > Account > API Management
# ============================================================================

# BINANCE_US_API_KEY=
# BINANCE_US_API_SECRET=

# ============================================================================
# Exchange: Coinbase
# Requires API key, secret, AND passphrase (all three are mandatory)
# Create keys at: Coinbase Pro > Settings > API
# ============================================================================

# COINBASE_API_KEY=
# COINBASE_API_SECRET=
# COINBASE_PASSPHRASE=

# ============================================================================
# Exchange: Kraken
# Create keys at: Kraken > Settings > API
# ============================================================================

# KRAKEN_API_KEY=
# KRAKEN_API_SECRET=

# ============================================================================
# Exchange: Bitfinex
# Create keys at: Bitfinex > Account > API
# Enable "Account Read" and "Orders Read/Write" permissions
# ============================================================================

# BITFINEX_API_KEY=
# BITFINEX_API_SECRET=

# ============================================================================
# Exchange: Hyperliquid (perpetuals DEX, wallet-based auth)
# Uses an Ethereum wallet private key instead of API key/secret
# IMPORTANT: Use a DEDICATED trading wallet with limited funds
# ============================================================================

# HYPERLIQUID_PRIVATE_KEY=0x...
# HYPERLIQUID_WALLET_ADDRESS=0x...

# ============================================================================
# Exchange: Uniswap (DEX — swaps across 15+ chains)
# API key from developers.uniswap.org for the Trading API
# ============================================================================

# UNISWAP_API_KEY=
# UNISWAP_WALLET_ADDRESS=0x...

# ============================================================================
# The Graph (optional — enables Uniswap subgraph data: candles, tickers, history)
# Free tier: 100K queries/month at https://thegraph.com/studio/
# Without this key, Uniswap trading still works but market data is limited
# ============================================================================

# THEGRAPH_API_KEY=

# ============================================================================
# Blockchain: Solana (DeFi, token swaps, staking, lending — 60+ tools)
# Export private key from Phantom/Solflare/solana-keygen (base58-encoded)
# IMPORTANT: Use a DEDICATED wallet with limited funds
# ============================================================================

# SOLANA_PRIVATE_KEY=
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional Solana integrations
# HELIUS_API_KEY=                  # Enhanced token metadata and DAS API
# JUPITER_REFERRAL_ACCOUNT=       # Jupiter referral program account
# JUPITER_FEE_BPS=                # Jupiter swap fee in basis points

# ============================================================================
# Blockchain: Polkadot (cross-chain swaps, staking, governance — 13 tools)
# Export mnemonic from Polkadot.js extension or subkey
# IMPORTANT: Use a DEDICATED wallet with limited funds
# ============================================================================

# POLKADOT_MNEMONIC=word1 word2 word3 ...
# POLKADOT_PRIVATE_KEY=0x...

# Optional Polkadot configuration
# POLKADOT_KEY_TYPE=Ed25519        # Ed25519 (default) or Sr25519
# POLKADOT_CHAINS=                 # Comma-separated chain IDs (default: all supported)

# ============================================================================
# Blockchain: Chainlink Data Streams (real-time institutional-grade prices)
# Sign up at data.chain.link for API access
# ============================================================================

# CHAINLINK_API_KEY=
# CHAINLINK_API_SECRET=

# ============================================================================
# Blockchain: EVM Private Key (Chainlink CCIP cross-chain bridging)
# Used for CCIP token transfers between EVM chains
# IMPORTANT: Use a DEDICATED wallet with limited funds
# ============================================================================

# EVM_PRIVATE_KEY=0x...

# ============================================================================
# Blockchain: Coinbase CDP (Base smart wallets, onchain actions — 10+ tools)
# Create API keys at portal.cdp.coinbase.com
# Enables: wallet management, ERC20 transfers, DEX swaps, Moonwell lending,
#          Basename registration, Pyth oracles, and more on Base L2
# ============================================================================

# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=
# CDP_WALLET_SECRET=
# CDP_NETWORK_ID=base-mainnet      # base-mainnet (production) or base-sepolia (testing)

# ============================================================================
# Blockchain: Base L2 (on-chain signals, whale detection, DEX analytics)
# Free API key from basescan.org — works without key but rate-limited
# Base read tools (registry, chain data, DexScreener) work without any keys
# ============================================================================

# BASESCAN_API_KEY=

# ============================================================================
# Data Provider: SynthData (AI probabilistic predictions & analytics)
# AI-powered price predictions, volatility forecasts, options pricing,
# liquidation risk, LP optimization, and Polymarket probability comparisons
# Sign up at synthdata.co for API access
# ============================================================================

# SYNTHDATA_API_KEY=

# ============================================================================
# Browser-native research and automation: Tinyfish
# ============================================================================

# TINYFISH_API_KEY=sk-tinyfish-...

# ============================================================================
# Database (optional, defaults to local SQLite files)
# ============================================================================

# Conversation history and task storage (LibSQL / Turso compatible)
# DATABASE_URL=file:gordon.db

# Vector database for semantic search / RAG
# VECTOR_DATABASE_URL=file:gordon-vector.db

# ============================================================================
# OpenTelemetry Tracing (optional — Axiom)
# ============================================================================

# Enable distributed tracing for agent operations
# OTEL_TRACING_ENABLED=false

# OTLP exporter endpoint (default: Axiom)
# OTEL_EXPORTER_OTLP_ENDPOINT=https://api.axiom.co/v1/traces

# Auth headers — Axiom API token + dataset name
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer xaat-XXXXXXXX,X-Axiom-Dataset=gordon-traces

# Service name for traces (default: gordon-trading)
# OTEL_SERVICE_NAME=gordon-trading

# ============================================================================
# Optional: Override default model selection
# ============================================================================

# Force a specific provider (auto-detected if not set)
# GORDON_PROVIDER=openai

# Force a specific model
# GORDON_MODEL=gpt-4o

# Use a different model for fast/cheap operations
# GORDON_FAST_PROVIDER=groq
# GORDON_FAST_MODEL=llama-3.1-8b-instant
