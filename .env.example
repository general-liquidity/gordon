# Gordon CLI - Environment Configuration
# Copy this file to .env and fill in your API keys

# ============================================================================
# LLM Provider (at least one required)
# ============================================================================

# OpenAI - Recommended, widely available
OPENAI_API_KEY=sk-...

# Dedalus Labs - Multi-model gateway (access 20+ models with one key)
# DEDALUS_API_KEY=dsk_...

# Anthropic Claude (optional)
# ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini (optional)
# GOOGLE_GENERATIVE_AI_API_KEY=...
# GOOGLE_API_KEY=...              # Alternative (fallback if above not set)

# Groq - Fast inference (optional)
# GROQ_API_KEY=gsk_...

# ============================================================================
# Exchange: Binance (required for trading)
# ============================================================================

BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret

# ============================================================================
# Exchange: Coinbase
# Requires API key, secret, AND passphrase (all three are mandatory)
# Create keys at: Coinbase Pro > Settings > API
# ============================================================================

# COINBASE_API_KEY=
# COINBASE_API_SECRET=
# COINBASE_PASSPHRASE=

# ============================================================================
# Exchange: Kraken
# Create keys at: Kraken > Settings > API
# ============================================================================

# KRAKEN_API_KEY=
# KRAKEN_API_SECRET=

# ============================================================================
# Exchange: Bitfinex
# Create keys at: Bitfinex > Account > API
# Enable "Account Read" and "Orders Read/Write" permissions
# ============================================================================

# BITFINEX_API_KEY=
# BITFINEX_API_SECRET=

# ============================================================================
# Exchange: Hyperliquid (perpetuals DEX, wallet-based auth)
# Uses an Ethereum wallet private key instead of API key/secret
# IMPORTANT: Use a DEDICATED trading wallet with limited funds
# ============================================================================

# HYPERLIQUID_WALLET_PRIVATE_KEY=0x...

# ============================================================================
# Exchange: Uniswap (DEX, wallet-based auth)
# API key from developers.uniswap.org for the Trading API
# ============================================================================

# UNISWAP_API_KEY=
# UNISWAP_WALLET_ADDRESS=0x...

# ============================================================================
# The Graph (optional — enables Uniswap market data: candles, tickers, history)
# Free tier: 100K queries/month at https://thegraph.com/studio/
# Without this key, Uniswap trading still works but market data is limited
# ============================================================================

# THEGRAPH_API_KEY=

# ============================================================================
# Database (optional, defaults to local SQLite files)
# ============================================================================

# Conversation history and task storage (LibSQL / Turso compatible)
# DATABASE_URL=file:gordon.db

# Vector database for semantic search / RAG
# VECTOR_DATABASE_URL=file:gordon-vector.db

# ============================================================================
# OpenTelemetry Tracing (optional — Axiom)
# ============================================================================

# Enable distributed tracing for agent operations
# OTEL_TRACING_ENABLED=false

# OTLP exporter endpoint (default: Axiom)
# OTEL_EXPORTER_OTLP_ENDPOINT=https://api.axiom.co/v1/traces

# Auth headers — Axiom API token + dataset name
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer xaat-XXXXXXXX,X-Axiom-Dataset=gordon-traces

# Service name for traces (default: gordon-trading)
# OTEL_SERVICE_NAME=gordon-trading

# ============================================================================
# Optional: Override default model selection
# ============================================================================

# Force a specific provider (auto-detected if not set)
# GORDON_PROVIDER=openai

# Force a specific model
# GORDON_MODEL=gpt-4o

# Use a different model for fast/cheap operations
# GORDON_FAST_PROVIDER=groq
# GORDON_FAST_MODEL=llama-3.1-8b-instant
