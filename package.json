{
  "name": "@general-liquidity/gordon-cli",
  "version": "0.8.8",
  "description": "The Frontier Trading Agent",
  "author": "General Liquidity, Inc.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/general-liquidity/gordon-cli.git"
  },
  "homepage": "https://github.com/general-liquidity/gordon-cli#readme",
  "bugs": "https://github.com/general-liquidity/gordon-cli/issues",
  "keywords": [
    "trading",
    "crypto",
    "ai",
    "cli",
    "binance",
    "cryptocurrency",
    "vibe-trading"
  ],
  "module": "src/index.tsx",
  "type": "module",
  "bin": {
    "gordon": "./dist/index.js"
  },
  "files": [
    "dist",
    "prompts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18",
    "bun": ">=1.0"
  },
  "scripts": {
    "start": "bun run src/index.tsx",
    "dev": "bun --watch run src/index.tsx",
    "build": "bun build src/index.tsx --outdir dist --target bun --external @lightprotocol/compressed-token --external @lightprotocol/stateless.js --external @solana-developers/helpers --external @galacticcouncil/api-augment/hydradx --external @galacticcouncil/api-augment/basilisk",
    "build:binary": "bun build src/index.tsx --compile --outfile gordon --external @lightprotocol/compressed-token --external @lightprotocol/stateless.js --external @solana-developers/helpers --external @galacticcouncil/api-augment/hydradx --external @galacticcouncil/api-augment/basilisk",
    "generate:actions-docs": "bun run scripts/generate-action-docs.ts",
    "test:broker-conformance": "bun test src/infra/broker/adapters/conformance.test.ts src/infra/broker/adapters/conformance.matrix.test.ts src/infra/broker/factory.extended.test.ts src/infra/broker/inclusion-gate.test.ts",
    "quality:brokers": "bun run scripts/broker-quality.ts --ci",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/patch-mastra.cjs"
  },
  "devDependencies": {
    "@types/asciichart": "^1.5.8",
    "@types/bun": "latest",
    "@types/node": "^25.1.0",
    "react-devtools-core": "^6.1.5",
    "shadcn": "^3.8.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.0.0",
    "@ai-sdk/google": "^1.0.0",
    "@ai-sdk/openai": "^1.0.0",
    "@chainlink/data-streams-sdk": "^1.2.1",
    "@coinbase/agentkit": "^0.10.4",
    "@inkjs/ui": "^2.0.0",
    "@libsql/client": "^0.6.0",
    "@libsql/linux-x64-gnu": "^0.5.22",
    "@lightprotocol/compressed-token": "^0.22.0",
    "@lightprotocol/stateless.js": "^0.22.0",
    "@mastra/core": "^1.5.0",
    "@mastra/libsql": "^1.5.0",
    "@mastra/mcp": "^1.0.1",
    "@mastra/memory": "^1.4.0",
    "@mastra/observability": "^1.2.0",
    "@mastra/otel-exporter": "^1.0.2",
    "@polkadot-agent-kit/sdk": "^2.1.5",
    "@solana-agent-kit/plugin-defi": "^2.0.8",
    "@solana-agent-kit/plugin-token": "^2.0.9",
    "@types/react": "^19.2.10",
    "ai": "^5.0.0",
    "asciichart": "^1.5.25",
    "ccxt": "^4.5.36",
    "ethers": "^6.16.0",
    "ink": "^6.6.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.4",
    "solana-agent-kit": "^2.0.10",
    "zod": "^4.3.6"
  }
}
