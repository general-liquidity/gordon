{
  "name": "@general-liquidity/gordon-cli",
  "version": "0.75.0",
  "description": "The Frontier Trading Agent",
  "author": "General Liquidity, Inc.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/general-liquidity/gordon-cli.git"
  },
  "homepage": "https://github.com/general-liquidity/gordon-cli#readme",
  "bugs": "https://github.com/general-liquidity/gordon-cli/issues",
  "keywords": [
    "trading",
    "crypto",
    "ai",
    "cli",
    "binance",
    "cryptocurrency",
    "vibe-trading"
  ],
  "module": "src/index.tsx",
  "type": "module",
  "bin": {
    "gordon": "./dist/gordon.js"
  },
  "files": [
    "dist",
    "prompts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18",
    "bun": ">=1.0"
  },
  "scripts": {
    "start": "bun run src/index.tsx",
    "dev": "bun --watch run src/index.tsx",
    "build": "bun build src/index.tsx --outdir dist --target bun",
    "build:binary": "bun build src/index.tsx --compile --outfile gordon",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/patch-mastra.cjs"
  },
  "devDependencies": {
    "@types/asciichart": "^1.5.8",
    "@types/bun": "latest",
    "@types/node": "^25.1.0",
    "react-devtools-core": "^6.1.5",
    "shadcn": "^3.8.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.0.0",
    "@ai-sdk/google": "^1.0.0",
    "@ai-sdk/openai": "^1.0.0",
    "@coinbase/agentkit": "^0.10.4",
    "@inkjs/ui": "^2.0.0",
    "@libsql/client": "^0.6.0",
    "@libsql/linux-x64-gnu": "^0.5.22",
    "@mastra/core": "^1.0.0",
    "@mastra/libsql": "^1.0.0",
    "@mastra/mcp": "^1.0.1",
    "@mastra/memory": "^1.0.0",
    "@types/react": "^19.2.10",
    "ai": "^5.0.0",
    "asciichart": "^1.5.25",
    "ccxt": "^4.5.36",
    "ethers": "^6.16.0",
    "ink": "^6.6.0",
    "ink-text-input": "^6.0.0",
    "protobufjs": "^8.0.0",
    "react": "^19.2.4",
    "zod": "^4.3.6"
  }
}
