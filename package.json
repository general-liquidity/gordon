{
  "name": "@general-liquidity/gordon",
  "version": "0.9.0",
  "private": false,
  "description": "The Frontier Trading Agent",
  "author": "General Liquidity, Inc.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/general-liquidity/gordon.git"
  },
  "homepage": "https://github.com/general-liquidity/gordon#readme",
  "bugs": "https://github.com/general-liquidity/gordon/issues",
  "keywords": [
    "trading",
    "crypto",
    "ai",
    "cli",
    "binance",
    "cryptocurrency",
    "vibe-trading"
  ],
  "module": "src/index.tsx",
  "type": "module",
  "bin": {
    "gordon": "./dist/index.js"
  },
  "files": [
    "dist",
    "scripts/patches/patch-mastra.cjs",
    "prompts",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18",
    "bun": ">=1.0"
  },
  "scripts": {
    "start": "bun run --silent src/index.tsx",
    "start:compiled": "GORDON_REACT_COMPILER=1 bun run --silent src/index.tsx",
    "dev": "bun --watch run src/index.tsx",
    "acp": "bun run src/app/acp-entry.ts",
    "dev:compiled": "GORDON_REACT_COMPILER=1 bun --watch run src/index.tsx",
    "build": "bun scripts/build/build.ts",
    "build:binary": "bun scripts/build/build.ts --binary",
    "generate:actions-docs": "bun run scripts/dev/codegen/generate-action-docs.ts",
    "test:broker-conformance": "bun test src/infra/broker/adapters/conformance.test.ts src/infra/broker/adapters/conformance.matrix.test.ts src/infra/broker/factory.extended.test.ts src/infra/broker/inclusion-gate.test.ts",
    "quality:brokers": "bun run scripts/dev/checks/broker-quality.ts --ci",
    "prepare:npm-wrapper": "node scripts/npm/prepare-npm-wrapper.cjs",
    "check:npm-wrapper": "node scripts/npm/check-npm-wrapper.cjs",
    "smoke:npm-wrapper": "node scripts/npm/smoke-npm-wrapper.cjs",
    "check:no-sourcemaps": "node scripts/build/check-no-sourcemaps.cjs",
    "audit:npm-pack": "node scripts/npm/audit-npm-pack.cjs",
    "audit:npm-pack-content": "node scripts/npm/audit-npm-pack-content.cjs",
    "audit:risk-tree": "node scripts/dev/checks/audit-risk-tree.cjs",
    "harness:simplify": "bun scripts/dev/harness/harness-simplification.ts",
    "harness:simplify:status": "bun scripts/dev/harness/harness-simplification.ts --status",
    "prepublishOnly": "bun run build && node scripts/build/check-no-sourcemaps.cjs",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "slop": "slop-scan scan .",
    "slop:json": "slop-scan scan . --json",
    "postinstall": "node scripts/patches/patch-mastra.cjs && node scripts/patches/patch-ink.cjs"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@biomejs/biome": "^2.5.0",
    "@types/asciichart": "^1.5.8",
    "@types/bun": "latest",
    "@types/node": "^25.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "react-devtools-core": "^6.1.5",
    "shadcn": "^3.8.3",
    "slop-scan": "^0.3.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "overrides": {
    "@tanstack/query-core": "5.90.20",
    "@tanstack/react-query": "5.90.21",
    "@tanstack/react-virtual": "3.13.18",
    "@tanstack/virtual-core": "3.13.18"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.22.1",
    "@ai-sdk/anthropic": "^1.0.0",
    "@ai-sdk/google": "^1.0.0",
    "@ai-sdk/openai": "^1.0.0",
    "@chainlink/data-streams-sdk": "^1.2.1",
    "@coinbase/agentkit": "^0.10.4",
    "@inkjs/ui": "^2.0.0",
    "@libsql/client": "^0.6.0",
    "@lightprotocol/compressed-token": "^0.22.0",
    "@lightprotocol/stateless.js": "^0.22.0",
    "@mastra/core": "^1.5.0",
    "@mastra/libsql": "^1.5.0",
    "@mastra/mcp": "^1.0.1",
    "@mastra/memory": "^1.4.0",
    "@mastra/observability": "^1.2.0",
    "@mastra/otel-exporter": "^1.0.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@polkadot-agent-kit/sdk": "^2.1.5",
    "@rezi-ui/native": "^0.1.0-alpha.60",
    "@rezi-ui/node": "^0.1.0-alpha.60",
    "@solana-agent-kit/plugin-defi": "^2.0.8",
    "@solana-agent-kit/plugin-token": "^2.0.9",
    "@stdlib/math-base-special-betainc": "^0.2.3",
    "@stdlib/math-base-special-erf": "^0.2.6",
    "@stdlib/math-base-special-erfinv": "^0.3.1",
    "@stdlib/math-base-special-gammaln": "^0.3.1",
    "@stdlib/random-base-mt19937": "^0.2.3",
    "@stdlib/stats-base-dists-chisquare-cdf": "^0.3.1",
    "@stdlib/stats-base-dists-normal-cdf": "^0.3.1",
    "@stdlib/stats-base-dists-normal-quantile": "^0.3.1",
    "@stdlib/stats-base-dists-t-cdf": "^0.2.3",
    "@types/react": "^19.2.10",
    "ai": "^5.0.0",
    "asciichart": "^1.5.25",
    "ccxt": "^4.5.36",
    "cli-highlight": "^2.1.11",
    "ethers": "^6.16.0",
    "ink": "^6.6.0",
    "ink-text-input": "^6.0.0",
    "marked": "^18.0.0",
    "ml-distance": "^4.0.1",
    "ml-hclust": "^4.0.0",
    "ml-matrix": "^6.12.2",
    "ml-pca": "^4.1.1",
    "react": "^19.2.4",
    "simple-statistics": "^7.9.0",
    "solana-agent-kit": "^2.0.10",
    "twitter-text": "^3.1.0",
    "zod": "^4.3.6"
  }
}
